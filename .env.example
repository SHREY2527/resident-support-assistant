# Copy this file to .env and fill in your own key: cp .env.example .env
# .env is gitignored — never commit your real key.

GEMINI_API_KEY=your-gemini-api-key

# --- Everything below is optional; defaults live in app/config.py ---

# Which Gemini models to use for the main answering step and for the router/judge step.
# MAIN_MODEL=gemini-3.6-flash
# ROUTER_MODEL=gemini-3.5-flash-lite

# Set to 0 to skip the judge verification pass (faster/cheaper, less safe).
# USE_JUDGE=1

# Override or add per-1M-token pricing (used only for the cost shown in usage.log), e.g. if the
# model name/pricing above has changed since this was written.
# MAIN_MODEL_INPUT_PRICE_PER_1M=0.75
# MAIN_MODEL_OUTPUT_PRICE_PER_1M=3.75
# ROUTER_MODEL_INPUT_PRICE_PER_1M=0.30
# ROUTER_MODEL_OUTPUT_PRICE_PER_1M=2.50
